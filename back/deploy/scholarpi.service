# Example systemd unit for running ScholarPi as a service without Docker.
#
# Install:
#   sudo cp deploy/scholarpi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scholarpi
#
# Adjust User/Group/WorkingDirectory/paths to match your deployment.
# Assumes you've already run `python -m venv venv && pip install -r
# requirements.txt` inside backend/, and created back/.env.

[Unit]
Description=ScholarPi — Pi-Index Assessment Engine
After=network.target

[Service]
Type=simple
User=scholarpi
Group=scholarpi
WorkingDirectory=/opt/scholarpi_webapp/back
Environment=ENVIRONMENT=production
Environment=SCHOLARPI_DATA_DIR=/opt/scholarpi_webapp/data
EnvironmentFile=/opt/scholarpi_webapp/back/.env
ExecStart=/opt/scholarpi_webapp/back/venv/bin/gunicorn api:app -c gunicorn.conf.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/scholarpi/scholarpi.log
StandardError=append:/var/log/scholarpi/scholarpi.log

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/scholarpi_webapp /home/scholarpi

[Install]
WantedBy=multi-user.target
