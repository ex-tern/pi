#!/bin/bash
# Face Mace Server's helper for the VPN: the only thing that runs as root. The server (user facemace) calls it
# through sudo with one of these commands, and each argument is checked before anything is changed:
#   pubkey                 the server's public key
#   peers                  the devices WireGuard has now (public keys)
#   transfer               per device: public key, bytes received, bytes sent, last handshake (unix time)
#   add KEY IP             let a device in, at its VPN address
#   remove KEY             take a device out
#   internet IP...         the devices allowed to use the VPN for the whole internet (all others: this server only)
set -euo pipefail
IF="${FMS_WG_IF:-wg0}"
KEY_RE='^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw480]=$'
IP_RE='^10\.66\.[0-9]{1,3}\.[0-9]{1,3}$'
cmd="${1:-}"
case "$cmd" in
  pubkey) wg show "$IF" public-key ;;
  peers) wg show "$IF" peers ;;
  transfer) wg show "$IF" dump | tail -n +2 | awk '{print $1, $6, $7, $5}' ;;
  add)
    [[ "${2:-}" =~ $KEY_RE && "${3:-}" =~ $IP_RE ]] || { echo "bad arguments" >&2; exit 2; }
    wg set "$IF" peer "$2" allowed-ips "$3/32" ;;
  remove)
    [[ "${2:-}" =~ $KEY_RE ]] || { echo "bad arguments" >&2; exit 2; }
    wg set "$IF" peer "$2" remove ;;
  internet)
    shift
    for ip in "$@"; do [[ "$ip" =~ $IP_RE ]] || { echo "bad address $ip" >&2; exit 2; }; done
    iptables -N FMS_NET 2>/dev/null || true
    iptables -F FMS_NET
    for ip in "$@"; do iptables -A FMS_NET -s "$ip/32" -j ACCEPT; done
    iptables -A FMS_NET -j DROP ;;
  *) echo "usage: fms-wg pubkey|peers|transfer|add KEY IP|remove KEY|internet IP..." >&2; exit 2 ;;
esac
