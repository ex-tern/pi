# Copy this file to `.env` (same folder) and fill in the values you have.
# Every key is optional — the app runs and degrades gracefully with any
# subset of these missing (see README "Running with no keys at all").

# --- LLM providers (used for manuscript assessment) -----------------------
# Primary judge + "llama" extractor. Get a free key at https://console.groq.com
GROQ_API_KEY=

# OpenRouter — powers the "mistral" and "qwen" jurors, and is a fallback for
# "llama"/"gemini" if GROQ_API_KEY / GEMINI_API_KEY aren't set.
# Get a key at https://openrouter.ai/keys
OR_API_KEY=

# Attribution headers OpenRouter uses to identify this application. Requests
# without them are treated as anonymous.
OPENROUTER_SITE_URL=https://scholarpi.up.railway.app
OPENROUTER_SITE_NAME=ScholarPi

# Provider routing policy: leave BLANK (recommended), or "deny"/"allow".
#
# IMPORTANT: this previously defaulted to "deny", which was wrong and is the
# most likely reason OpenRouter jurors were failing. "deny" is a RESTRICTION —
# it tells OpenRouter to use only providers that do not retain prompts. For a
# model served solely by logging providers, that removes every endpoint and
# produces exactly the error it was meant to prevent:
#
#   "No endpoints available matching your guardrail restrictions and data policy"
#
# Leaving it blank lets your OpenRouter account's own privacy setting decide,
# which gives the widest model availability. Set it explicitly only to override.
OPENROUTER_DATA_COLLECTION=

# Google Gemini — powers the "gemini" extractor.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Additional direct providers (all free tiers, all optional) -------------
# These matter more than they look. Without them, every juror except "llama"
# reaches its model ONLY through OpenRouter — so one OpenRouter data-policy
# rejection silently collapses four of the five jurors at once, and the panel
# reports a one-model verdict wearing a five-model label.
#
# Setting even two of these gives each juror an OpenRouter-independent path.
# Run `python check_providers.py` to see exactly which jurors are reachable.
#
# Cerebras — free tier, very fast. Serves the llama and qwen jurors.
#   https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral La Plateforme — free tier. Gives the mistral juror a direct path.
#   https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# DeepSeek — direct path for the deepseek juror (a different model lineage,
# which is what makes its agreement with the others meaningful).
#   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Together AI — free-tier Llama and Qwen endpoints.
#   https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=
# GitHub Models — free with any GitHub personal access token (no scopes
# needed). Backstops the gemini juror when the Google quota is exhausted.
#   https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# --- IPFS / state backup (Pinata) ------------------------------------------
# https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# --- Ethereum / Web3 (Sepolia testnet) --------------------------------------
WEB3_PROVIDER_URI=https://ethereum-sepolia-rpc.publicnode.com
# Additional RPC endpoints tried in order if the primary stops responding.
# Public testnet RPCs rate-limit and go down often, so the app fails over
# automatically instead of losing all chain features to one flaky provider.
# Comma-separated; leave blank to use the built-in fallback list.
WEB3_FALLBACK_RPCS=
CHAIN_ID=11155111
CHAIN_NAME=Sepolia
CHAIN_CURRENCY=SepoliaETH
BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
# Private key of the wallet that owns/administers the deployed contracts.
# NEVER commit this. Only needed if you want real on-chain piQ minting /
# state backup — everything else works fine without it.
ETH_ADMIN_PRIVATE_KEY=
# OPTIONAL — leave blank unless you have deployed a second, separate contract
# for this purpose. It stores an IPFS CID pointing at an encrypted backup of
# the ledger state, and is used by nothing else: scoring, minting, piQ balances
# and the Proof-of-Research chain all work identically without it.
#
# This is NOT your piQ token contract. The token is a valid deployed contract
# with nowhere to store a CID, so anchoring calls revert during gas estimation.
# The address is probed at runtime (code present + getCID() answers) and the
# result is reported by /api/backup/status, so a wrong address is visible
# rather than silently disabling anchoring.
#
# Backups do NOT depend on this. Encrypted snapshots are pinned to IPFS and
# their CIDs recorded locally whenever Pinata credentials and an encryption
# key exist; the registry only adds an on-chain tamper-evidence trail.
REGISTRY_CONTRACT_ADDRESS=
# piQ ERC-20-style token contract. Defaults to the address already baked
# into config.py if left blank.
PIQ_CONTRACT_ADDRESS=0x17AF5399986C34e16Df8fB830eB8e2048b878A88

# --- ORCID OAuth -------------------------------------------------------------
# Register an app at https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Must match the redirect URI configured in your ORCID app exactly.
ORCID_REDIRECT_URI=http://localhost:8000/api/auth/orcid/callback

# --- Local app config ---------------------------------------------------------
# Where the frontend is served from (used to build ORCID redirect URLs back
# to the browser). Change only if you deploy this somewhere other than
# localhost:8000.
FRONTEND_ORIGIN=http://localhost:8000

# Web3 wallet address allowed to reset the local Scilem neural model.
OWNER_ID=0x6B89DD74DCa5d4DC98599206b1c2dE614066ef40

# --- Production / deployment settings ---------------------------------------
# "development" (default, permissive CORS) or "production" (restricts CORS
# to FRONTEND_ORIGIN/ALLOWED_ORIGINS, hides API docs, hides error detail).
ENVIRONMENT=development

# Comma-separated CORS allow-list, e.g. https://scholarpi.example.com
# Leave blank to use the ENVIRONMENT-based default described above.
ALLOWED_ORIGINS=

# Where the SQLite DB, PyTorch model weights, and logs are stored. Defaults
# to ~/Scientometric_Pi_Index if unset.
#
# THIS IS THE MOST IMPORTANT SETTING FOR NOT LOSING DATA.
#
# Everything that matters lives here: the Proof-of-Research ledger, piQ
# balances, every assessment, and the trained Scilem weights. On Railway,
# Render, Fly and Heroku the container filesystem is EPHEMERAL — it is
# recreated on every deploy — so if this points anywhere that is not a mounted
# persistent volume, the entire ledger is destroyed on your next push. Nothing
# errors when this happens; the app simply starts empty.
#
#   Docker Compose : already handled (named volume scholarpi_data -> /data)
#   Railway        : add a Volume, mount at /data, set SCHOLARPI_DATA_DIR=/data
#   Render         : add a Disk,   mount at /data, set SCHOLARPI_DATA_DIR=/data
#   Fly.io         : create a volume, mount at /data, set SCHOLARPI_DATA_DIR=/data
#
# Check it worked: GET /api/health reports storage.verdict. "persistent" means
# the directory survived a restart. If it says "fresh" on every deploy, the
# volume is not mounted and you are losing data each time.
SCHOLARPI_DATA_DIR=

# Per-file upload cap in MB, enforced before any PDF parsing happens.
MAX_UPLOAD_MB=25

# Free assessments allowed per client IP before a connected Web3 wallet is
# required — enforced server-side, not just in the browser. This is how a new
# user earns the first piQ that funds their subsequent runs.
FREE_EVALS_PER_IP=3

# Flat piQ fee charged per manuscript, debited from the submitter's balance
# at the moment that paper starts processing. Refunded automatically if the
# paper's source can't be retrieved. Set to 0 to disable fees entirely.
PIQ_PROCESSING_FEE=0.1

# Wallet that receives Support & Donate contributions from the sidebar.
DONATION_WALLET=0x6B89DD74DCa5d4DC98599206b1c2dE614066ef40

# In-process rate limiting for the assessment/chat endpoints.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10

# --- Forecasting -------------------------------------------------------------
# The Pidyne LSTM trains inside the HTTP request. On a memory-constrained host
# that risks the worker being OOM-killed, which the browser sees as "could not
# reach the forecasting service" — and an OOM kill terminates the process, so
# no in-process fallback can catch it.
#
# DEFAULTS TO "false": a statistical projection (Holt linear trend) is used
# instead. On a series of a few dozen points the two largely agree, and one of
# them cannot take the server down. Set "true" only with real memory headroom.
USE_LSTM_FORECAST=false

# Gemini model tried first. The free tier rate-limits aggressively; the
# provider chain falls back through older flash models and then OpenRouter.
GEMINI_PRIMARY_MODEL=gemini-2.5-flash

# --- Research integrity ------------------------------------------------------
# The adversarial-injection defence and reference auditing need no keys. Note
# that reference verification calls OpenAlex and Crossref (both free, no auth);
# if those hosts are unreachable, every DOI is recorded as *unverifiable* and
# no penalty is ever applied, so an outage cannot produce a false accusation.

# Gunicorn worker count (production only, see gunicorn.conf.py).
WEB_CONCURRENCY=2

# The Scilem sidebar chat lazily loads a local TinyLlama model that needs far
# more RAM than a small/free host has (Render's 512MB tier, for example).
# DEFAULTS TO "false": the assistant UI is disabled and the app explains that
# the local language model is inactive due to server limitations. Set to
# "true" on a machine with sufficient memory to re-enable it. Manuscript
# assessment does not use this model and is unaffected either way.
ENABLE_SCILEM_LOCAL_MODEL=false

# The Scilem ASSISTANT is separate from the local model above and is ON by
# default. It answers from the live database and a knowledge base built from
# the running rubric, so it needs no model and cannot hallucinate a balance.
ENABLE_SCILEM_ASSISTANT=true

# --- Free-tier challenge -----------------------------------------------------
# Proof-of-work is required for anonymous submissions and needs no keys.
REQUIRE_PROOF_OF_WORK=true
# Optional additional Cloudflare Turnstile layer; leave blank to skip.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Backups -----------------------------------------------------------------
# Encryption key for the IPFS state backup. Separate from the signing key so a
# deployment can have encrypted durable backups without holding a funded key.
BACKUP_ENCRYPTION_KEY=
# Minimum seconds between automatic backups. Backups run on a background
# thread; without this they fired once per assessed paper, zipping and
# uploading the whole database inside the request.
BACKUP_MIN_INTERVAL_SECONDS=900

# --- Bug reports -------------------------------------------------------------
BUG_REPORT_TO=a.vafadaryengejeh@campus.unimib.it
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Assistant ---------------------------------------------------------------
# limited = state plainly that capability is reduced (correct on a small host).
# auto    = infer from configured provider keys.
SCILEM_MODE=limited

# --- Sessions ----------------------------------------------------------------
# Signs session tokens. Without it (and without ETH_ADMIN_PRIVATE_KEY) sign-in
# is DISABLED and every identity-scoped feature refuses rather than falling back
# to trusting a query parameter — which is what previously let anyone act as the
# owner by reading the public owner address and passing it back.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_SECONDS=43200
