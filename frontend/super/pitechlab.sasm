; Pi Tech Lab, written in SuperAI assembly.
;
; SuperAI is the site's graphical language: supers joined by wires, data flowing from outputs into inputs,
; powered by AI engines. This is the program the front end runs. scripts/build_program.py assembles it with
; the Rust engine (rust/superai, asm.rs) into super/pitechlab.super.js, which super/runtime.js loads as
; SuperAI.program. The signs:
;
;   ◇ a source (a part of index.html whose cards become windows)   ◯ a bubble   ⊕ windows merged into one
;   ■ square ● dot ◆ diamond ✦ sparkle ▣ holder: a super   ⊙ an input or output   ⟶ a wire   connectors: ▷ output ◁ input △ sync ▽ condition   ▭ a section of the map   ▣ a super on the map
;   graph … end   a graph function     fn … end   a stack-machine function (Turing complete, vm.rs)
;   .key value    a value               ; a comment
;
; In a fn, one simple word per line works on a stack of values:
;   push 5   in name   get x   set x   add sub mul div cat   if L   ifnot L   goto L   L:   say   stop
;   ask sim  sends the text on top to an LLM (sim, rib, pid, pien, llama, mistral, qwen, gemini, deepseek)
;            and puts its answer on top. ◁ △ ▽ read what is wired into input, sync, condition; ▷ is output.

.language "SuperAI 1"
.name "Pi Tech Lab"

; native blocks
◇ assess "Evaluate" panel=tab-assess
◇ journal "Explore" panel=tab-journal
◇ analytics "Envision" panel=tab-analytics
◇ lab "Lab" panel=tab-lab
◇ diagram "Architecture" panel=tab-diagram
◇ account "Account" panel=null

; window titles
.put titles.byId "signInNotice" "Why sign in"
.put titles.byId "profileCard" "Research profile"
.put titles.byId "resultsSection" "Assessment results"
.put titles.byId "historyCard" "Your assessments"
.put titles.byId "ownerResetCard" "Reset platform"
.put titles.byId "claimableCard" "piQ held for you"
.put titles.retitle "assess:Assess a Manuscript" "Assess Manuscripts [Pi]"
.put titles.retitle "analytics:Forecast" "Performance"
.put titles.retitle "account:SciLM (siM) Assistant" "SciM Assistant"
.put titles.renamed "analytics:Key numbers" "analytics:Analytics"
.put titles.renamed "analytics:Forecast" "analytics:Performance"
.put titles.renamed "account:SciLM (siM) Assistant" "account:SciM Assistant"
.put titles.renamed "account:siM Assistant" "account:SciM Assistant"
.put titles.renamed "assess:ResBD" "assess:RiBD"
.put titles.renamed "assess:Assess a Manuscript" "assess:Assess Manuscripts [Pi]"
.put titles.renamed "account:Support ScholarPi" "account:Support Pi"
.put titles.renamed "lib:Lib group" "lib:Library group"
.push hide "SciM Assistant"

; windows merged into one
⊕ journal "Leaderboards" parts="pi-Index (piX) Leaderboard [Top Papers]","pi-Quotient (piQ) Leaderboard [Top Authors]"
⊕ diagram "Architecture" parts=Overview,"Scoring Pipeline in Detail","Stage Reference","CoARA Compliance & Core Pillars"

; the bubbles and where they start: packed close together, about 5 px apart (owner, 2026-10-13: "make the supers very close to each other")
◯ "Lab" source=lab at.fx=0.094 at.fy=0.168 at.inSite=0.278,0.291 atPhone.inSite=0.73,0.56
◯ "Tools" members="Assess Manuscripts [Pi]", at.fx=-0.073 at.fy=-0.19 at.inSite=0.278,0.155 atPhone.inSite=0.27,0.34
◯ "Library" key=lib members=RiBD,"The Global Map of Science",Whitepaper,Architecture,Capabilities at.fx=0.333 at.fy=-0.19 at.inSite=0.346,0.291 atPhone.inSite=0.27,0.56
◯ "Explore" key=explore members=Live,"The journal",Leaderboards,"Proof-of-Research Ledger Explorer","Recent assessments",Analytics,Performance,"Minting Difficulty" at.fx=0.151 at.fy=-0.19 at.inSite=0.346,0.155 atPhone.inSite=0.73,0.34
◯ "Connect" key=connect at.fx=-0.375 at.fy=-0.223 at.inSite=0.083,0.220 atPhone.inSite=0.5,0.17 members="Your account","Your assessments","Research profile","piQ held for you","Assessment results","Reset platform","Why sign in","Invite a researcher","Support Pi","Contact us",GitHub

; the start: the supers and wires a first visit begins with
diagram
  ▣ hold box desktop n=1000 at.inSite=0.168,0.069,0.387,0.376
  ⟶ main△ site△
  ⟶ title▷ site△
  ⟶ site▽ main▽
  ⟶ main◁ site◁
  ⟶ site▷ main▷
  ⟶ site△ bubble:Connect△
  ⟶ site△ hold△
  ⟶ hold△ bubble:Tools△
  ⟶ hold△ bubble:Explore△
  ⟶ hold△ bubble:Library△
  ⟶ bubble:Connect▷ hold◁
  ⟶ bubble:Tools▷ bubble:Explore◁
  ⟶ bubble:Explore▷ bubble:Library◁
  ⟶ bubble:Lab▷ project◁
  ⟶ bubble:Explore▽ bubble:Lab△
  ⟶ site△ project△
end

.projectAt inSite=0.253,0.466
.live source=/api/live every=30 status=liveStatus counts=liveCounts ago=ago inside=Explore

graph percent
  ⊙ part input
  ⊙ whole input
  ■ hundred "100"
  ■ times "×"
  ■ over "/"
  ■ round "round"
  ⊙ out output
  ⟶ hundred▷ times◁
  ⟶ part▷ times◁
  ⟶ times▷ over◁
  ⟶ whole▷ over◁
  ⟶ over▷ round◁
  ⟶ whole▷ round▽
  ⟶ round▷ out◁
end

graph ago
  ⊙ m input
  ■ one "1"
  ■ sixty "60"
  ■ day "1440"
  ■ lt1 "<"
  ■ lt60 "<"
  ■ ltday "<"
  ■ now "just now"
  ■ minw "min ago"
  ■ mins "+"
  ■ inh "/"
  ■ rh "round"
  ■ hw "h ago"
  ■ hrs "+"
  ■ ind "/"
  ■ rd "round"
  ■ dw "d ago"
  ■ days "+"
  ■ pick
  ⊙ out output
  ⟶ m▷ lt1◁
  ⟶ one▷ lt1◁
  ⟶ lt1▷ now▽
  ⟶ m▷ lt60◁
  ⟶ sixty▷ lt60◁
  ⟶ m▷ mins◁
  ⟶ minw▷ mins◁
  ⟶ lt60▷ mins▽
  ⟶ m▷ ltday◁
  ⟶ day▷ ltday◁
  ⟶ m▷ inh◁
  ⟶ sixty▷ inh◁
  ⟶ inh▷ rh◁
  ⟶ rh▷ hrs◁
  ⟶ hw▷ hrs◁
  ⟶ ltday▷ hrs▽
  ⟶ m▷ ind◁
  ⟶ day▷ ind◁
  ⟶ ind▷ rd◁
  ⟶ rd▷ days◁
  ⟶ dw▷ days◁
  ⟶ now▷ pick◁
  ⟶ mins▷ pick◁
  ⟶ hrs▷ pick◁
  ⟶ days▷ pick◁
  ⟶ pick▷ out◁
end

graph liveStatus
  ⊙ enabled input
  ⊙ working input
  ■ off "not"
  ■ busy "and"
  ■ manual "Papers are assessed when people submit them."
  ■ now "Assessing a paper now, found on its own while the site is quiet."
  ■ idle "Working while idle. When the site is quiet it finds open-access papers and assesses them."
  ■ pick
  ⊙ out output
  ⟶ enabled▷ off◁
  ⟶ off▷ manual▽
  ⟶ enabled▷ busy◁
  ⟶ working▷ busy◁
  ⟶ busy▷ now▽
  ⟶ enabled▷ idle▽
  ⟶ manual▷ pick◁
  ⟶ now▷ pick◁
  ⟶ idle▷ pick◁
  ⟶ pick▷ out◁
end

graph liveCounts
  ⊙ today input
  ⊙ byself input
  ⊙ total input
  ⊙ enabled input
  ■ tw "assessed today"
  ■ day "+"
  ■ open "("
  ■ close "by itself)"
  ■ n "&"
  ■ self "+"
  ■ dot "·"
  ■ allw "in total"
  ■ all "+"
  ■ line "+"
  ⊙ out output
  ⟶ today▷ day◁
  ⟶ tw▷ day◁
  ⟶ open▷ n◁
  ⟶ byself▷ n◁
  ⟶ n▷ self◁
  ⟶ close▷ self◁
  ⟶ enabled▷ self▽
  ⟶ dot▷ all◁
  ⟶ total▷ all◁
  ⟶ allw▷ all◁
  ⟶ day▷ line◁
  ⟶ self▷ line◁
  ⟶ all▷ line◁
  ⟶ line▷ out◁
end

graph add
  ⊙ a input
  ⊙ b input
  ■ plus "+"
  ⊙ out output
  ⟶ a▷ plus◁
  ⟶ b▷ plus◁
  ⟶ plus▷ out◁
end

; the project map: the whole project as one super's inside
map
  ▭ "one prompt, every engine" x=14 y=0 w=972 h=270
  ▭ "the assessment" x=14 y=300 w=972 h=110
  ▭ "the site" x=14 y=470 w=972 h=100
  .siteRow x=20 y=500 w=960 h=40 extra=[]
  ▣ prompt "Prompt" kind=in x=20 y=120 w=150 h=64 input
  ▣ superai "Super AI" kind=ai x=210 y=128 w=96 h=48 probe=/api/super/engines,"{ready} engines"
  ▣ sim "siM" kind=lab engine=sim x=350 y=20 w=74 h=40 probe=/api/scilem/status,"{badge}" opens=Capabilities
  ▣ rib "riB" kind=lab engine=rib x=350 y=76 w=74 h=40 probe=/api/engines/status,"{riB.weights#} weights" opens=Capabilities
  ▣ pid "piD" kind=lab engine=pid x=350 y=132 w=74 h=40 probe=/api/forecast,"{blocks_recorded} blocks" opens=Performance
  ▣ pien "PiEn" kind=lab engine=pien x=350 y=188 w=74 h=40 probe=/api/pien/model,"{interactions} uses" opens=Capabilities
  ▣ llama "Llama" kind=out engine=llama x=470 y=8 w=74 h=40
  ▣ mistral "Mistral" kind=out engine=mistral x=470 y=58 w=74 h=40
  ▣ qwen "Qwen" kind=out engine=qwen x=470 y=108 w=74 h=40
  ▣ gemini "Gemini" kind=out engine=gemini x=470 y=158 w=74 h=40
  ▣ deepseek "DeepSeek" kind=out engine=deepseek x=470 y=208 w=74 h=40
  ▣ judge "Judge" kind=judge x=600 y=108 w=74 h=40 probe=/api/super/engines,"{judge?ready:no key}"
  ▣ answer "Answer" kind=sink x=720 y=70 w=160 h=118
  ▣ live "Live" kind=site x=906 y=20 w=74 h=40 probe=/api/live,"{today} today" opens="@live"
  ▣ traffic "Traffic" kind=site x=906 y=200 w=74 h=40 probe=/api/traffic,"{today} visits" opens=Analytics
  ▣ manuscript "Manuscript" kind=in x=20 y=330 w=92 h=46 probe=/api/stats/count,"{total_analyzed} assessed" opens="Assess Manuscripts [Pi]"
  ▣ extract "Extract" kind=step x=132 y=333 w=88 h=40 note="PDF → text"
  ▣ integrity "Integrity" kind=step x=238 y=333 w=88 h=40 note="MDAR · RRID"
  ▣ jurors "Jurors" kind=step x=344 y=333 w=88 h=40 probe=/api/super/engines,"{outside} models"
  ▣ verdict "Verdict" kind=judge x=450 y=333 w=88 h=40 note="the judge"
  ▣ pix "piX" kind=step x=556 y=333 w=88 h=40 probe=/api/analytics/summary,"avg {avg_score|0}" opens=Whitepaper
  ▣ piq "piQ" kind=step x=662 y=333 w=88 h=40 probe=/api/emission,"floor {current_quality_floor|1}" opens="Minting Difficulty"
  ▣ ledger "Ledger" kind=step x=768 y=333 w=88 h=40 probe=/api/chain/status,"{chain_name} #{block_number}" opens="Proof-of-Research Ledger Explorer"
  ▣ explorer "Explorer" kind=sink x=874 y=333 w=106 h=40 probe=/api/explorer/latest,"{count} records" opens="Proof-of-Research Ledger Explorer"
  ⟶ prompt superai
  ⟶ superai sim
  ⟶ superai rib
  ⟶ superai pid
  ⟶ superai pien
  ⟶ superai llama
  ⟶ superai mistral
  ⟶ superai qwen
  ⟶ superai gemini
  ⟶ superai deepseek
  ⟶ llama judge
  ⟶ mistral judge
  ⟶ qwen judge
  ⟶ gemini judge
  ⟶ deepseek judge
  ⟶ judge answer
  ⟶ sim answer
  ⟶ manuscript extract
  ⟶ extract integrity
  ⟶ integrity jurors
  ⟶ jurors verdict
  ⟶ verdict pix
  ⟶ pix piq
  ⟶ piq ledger
  ⟶ ledger explorer
  ⟶ pix pid
  ⟶ pix rib
  ⟶ b-Tools manuscript
  ⟶ explorer b-Explore
  ⟶ ledger live
end

; a function in plain words that prompts an LLM: SuperAI.ask("explain", {topic: "piX"})
fn explain topic
  push "Explain in one short sentence for a newcomer: "
  in topic
  cat
  ask sim            ; the lab's own assistant answers (or llama, mistral, qwen, gemini, deepseek)
  say
end
